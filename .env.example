# FAMONEMEDIA Reverse AI - Environment Configuration Example
# Copy this file to .env to customize local server and model parameters

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Hardware & CPU Allocation
MAX_CPU_THREADS=8
NUM_WORKERS=4
LOW_MEMORY_MODE=false

# Shot Boundary Detection
TRANSNET_THRESHOLD=0.5
SCENEDETECT_THRESHOLD=27.0
SCENEDETECT_ADAPTIVE_THRESHOLD=3.0
MIN_SCENE_LEN_FRAMES=8
FRAME_SNAPPING_TOLERANCE=3

# Speech & Audio
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
AUDIO_SAMPLE_RATE=16000

# On-Screen Text Detection (PP-OCR)
OCR_ENGINE=rapidocr
OCR_CONFIDENCE_THRESHOLD=0.5
OCR_SAMPLE_FPS=1.0

# Visual Understanding (Qwen2.5-VL-3B)
ENABLE_QWEN=true
QWEN_DEVICE=cpu
QWEN_MAX_TOKENS=256
